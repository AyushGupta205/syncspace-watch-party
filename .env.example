# Server Port (Render injects this automatically)
PORT=3005

# Environment
NODE_ENV=production

# Node Version (Render blueprint)
NODE_VERSION=22

# Optional comma-separated browser origins. In production, an empty value allows same-origin only.
CLIENT_ORIGIN=
TRUST_PROXY=false

# SQLite Database Path (use a durable mounted volume in production)
DB_PATH=data/syncspace.db

# Per-process resource limits
MAX_ROOMS=500
MAX_PARTICIPANTS_PER_ROOM=100
MAX_CONNECTIONS=5000
MAX_CONNECTIONS_PER_IP=100

# Optional bearer token for the aggregate /api/metrics endpoint.
# Required in production to make the endpoint available.
METRICS_TOKEN=
